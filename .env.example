# Picovoice (wake word) -- free signup: https://console.picovoice.ai
PICOVOICE_ACCESS_KEY=

# Optional overrides -- defaults live in jarvis/config.py
WAKE_WORD=jarvis
WAKE_SENSITIVITY=0.5
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8

# Phase 5 -- Gmail OAuth (leave blank until Phase 5)
GOOGLE_OAUTH_CLIENT_SECRET_PATH=

# Phase 6 -- Sabanci SUIS (leave blank until Phase 6)
SUIS_USERNAME=
SUIS_PASSWORD=

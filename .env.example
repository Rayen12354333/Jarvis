# Wake word (openWakeWord) -- no signup, no key. See PLAN.md section 2 for why
# this replaced Porcupine.
WAKE_WORD_MODEL=hey_jarvis
WAKE_THRESHOLD=0.5

# Conversation timing (seconds)
# How long Jarvis waits for you to START speaking after a prompt.
SPEECH_START_TIMEOUT_S=10.0
# How much silence marks the END of an utterance.
SILENCE_TIMEOUT_S=0.9
# Maximum spoken length of one request after speech begins.
MAX_RECORDING_S=15.0
# Temporarily mute speaker/video audio only while waiting for your request.
MUTE_OUTPUT_WHILE_LISTENING=true

# Speech-to-text
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8

# Text-to-speech (Kokoro-82M) -- voice id like am_adam, bm_lewis, af_heart.
# Full list: https://github.com/gabrimatic/kokoro-mlx
VOICE_NAME=am_adam
# >1 faster, <1 slower
VOICE_SPEED=1.0

# LLM fallback (Gemini) -- free API key, no card: aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional second brain: a GroqCloud-hosted specialist + Gemini fallback.
# A gsk_ key comes from console.groq.com; Groq is distinct from xAI's Grok.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Phase 5 -- Gmail OAuth (leave blank until Phase 5)
GOOGLE_OAUTH_CLIENT_SECRET_PATH=

# Phase 6 -- Sabanci SUIS (leave blank until Phase 6)
SUIS_USERNAME=
SUIS_PASSWORD=
